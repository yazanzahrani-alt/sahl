PORT=3002
# Comma-separated exact origins. Wildcards are rejected because sessions use credentials.
WEB_ORIGIN=http://localhost:5175,http://127.0.0.1:5175
# Set to none only when your frontend and API use different domains in production.
SESSION_COOKIE_SAME_SITE=lax

NODE_ENV=development

SQLITE_PATH=./data/sahl.db
UPLOADS_PATH=./data/uploads

# Optional synthetic demo timing only. This is not a universal Bupa policy rule.
# Leave unset to report submission timing as unavailable.
# SYNTHETIC_DEMO_SUBMISSION_WINDOW_DAYS=90
# Optional category overrides use the same synthetic-only semantics.
# SYNTHETIC_DEMO_INPATIENT_WINDOW_DAYS=90
# SYNTHETIC_DEMO_DENTAL_WINDOW_DAYS=90
# SYNTHETIC_DEMO_OPTICAL_WINDOW_DAYS=90
# SYNTHETIC_DEMO_OUTPATIENT_WINDOW_DAYS=90

DEMO_OPS_ENABLED=true
# Comma-separated 8-digit prototype identities allowed to use the cross-claim Demo Ops view.

DOCUMENT_INTELLIGENCE_PROVIDER=openai
OPENAI_MODEL=gpt-5.6-terra
# Required to analyse documents when the OpenAI provider is selected.
# OPENAI_API_KEY=replace_with_your_key
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=2

# Optional Gemini provider. OpenAI-specific timeout/retry settings do not apply.
# DOCUMENT_INTELLIGENCE_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.6-flash
# Required to analyse documents when the Gemini provider is selected.
# GEMINI_API_KEY=replace_with_your_key
